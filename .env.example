# Postgres connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/womenbuilders_dev"
# Optional: non-pooled connection for migrations (Supabase session pooler, port 5432). Used by `vercel-build`.
# DIRECT_URL=""
# Public origin of the app. Used for links in emails and the API origin check.
APP_URL="http://localhost:3000"
# Timezone used for "today" in admin follow-up queues
APP_TIMEZONE="America/New_York"
# Secret for signing unsubscribe links (openssl rand -base64 32)
APP_SECRET="change-me"
# Bearer token that cron routes require
CRON_SECRET="change-me"
# Email. Without RESEND_API_KEY, emails are printed to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Women Builders <hello@example.com>"
# Seed script
ADMIN_EMAIL="admin@example.com"
ADMIN_INITIAL_PASSWORD="ChangeMe123"
# Photo storage. "local" (default) writes to STORAGE_DIR. On Vercel use "blob" (private Vercel Blob store;
# BLOB_STORE_ID / BLOB_READ_WRITE_TOKEN is added by Vercel when you connect a store, and "blob" is then picked automatically).
# "s3" works with any S3-compatible service.
STORAGE_DRIVER="local"
STORAGE_DIR=".data/storage"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# BLOB_READ_WRITE_TOKEN=""
