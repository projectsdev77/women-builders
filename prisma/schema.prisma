// Women Builders: database schema (Spec Revision 2).
// Gap references (G#) point to .kiro/specs/women-builders-platform/gap-resolutions.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  FOUNDER
  OPERATOR
  INVESTOR
  BUILDER
}

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  DEACTIVATED
  DELETED // anonymised: details erased, conversations kept for the other person (G11)
}

enum DeactivatedBy {
  SELF
  ADMIN
}

enum ConnectionRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum OutreachStatus {
  IDENTIFIED
  REVIEWED
  CONTACTED
  FOLLOW_UP_NEEDED
  INTERESTED
  REQUESTED // asked for an invitation on the website (R3 F3)
  INVITED
  APPLIED // retired in R3 (no self-registration); kept for history
  APPROVED // shown as 'Joined'
  NOT_INTERESTED
  NOT_A_FIT
  DO_NOT_CONTACT
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ReportReason {
  HARASSMENT
  SPAM
  FAKE_PROFILE
  INAPPROPRIATE_CONTENT
  INAPPROPRIATE_PHOTO
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique // always stored normalized (G11)
  passwordHash         String
  name                 String
  isAdmin              Boolean        @default(false)
  accountStatus        AccountStatus  @default(PENDING)
  deactivatedBy        DeactivatedBy?
  emailVerifiedAt      DateTime?
  applicationStatement String?        @db.Text
  approvedAt           DateTime?
  rejectedAt           DateTime?
  reviewNote           String?        @db.Text // internal admin note on approve/reject
  lockedUntil          DateTime? // global backstop lock (G7)
  charterVersion       Int? // version of the community charter accepted (R3 F2)
  charterAcceptedAt    DateTime?
  charterNoticeVersion Int? // last charter version we emailed about
  allowIntroRequests   Boolean  @default(true) // "Let members ask me for introductions" (R3 F12)
  preferIntroductions  Boolean  @default(false) // no direct connection requests (R3 F11)
  isReviewer           Boolean  @default(false) // member reviewer: votes on invitation requests (R3 F21, R2)
  lastActiveAt         DateTime       @default(now())
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  profile                 Profile?
  sessions                Session[]
  tokens                  AuthToken[]
  sentRequests            ConnectionRequest[]        @relation("RequestSender")
  receivedRequests        ConnectionRequest[]        @relation("RequestReceiver")
  connectionsA            Connection[]               @relation("ConnectionA")
  connectionsB            Connection[]               @relation("ConnectionB")
  sentMessages            Message[]                  @relation("MessageSender")
  receivedMessages        Message[]                  @relation("MessageReceiver")
  dismissals              DismissedRecommendation[]  @relation("Dismisser")
  dismissedBy             DismissedRecommendation[]  @relation("Dismissed")
  blocksMade              Block[]                    @relation("Blocker")
  blocksReceived          Block[]                    @relation("Blocked")
  reportsMade             Report[]                   @relation("Reporter")
  reportsReceived         Report[]                   @relation("ReportedUser")
  reportsResolved         Report[]                   @relation("ReportResolver")
  notificationPreference  NotificationPreference?
  potentialMember         PotentialMember?           @relation("PotentialMemberUser")
  assignedPotentialMembers PotentialMember[]         @relation("PotentialMemberAssignee")
  invitationsSent         Invitation[]               @relation("InvitationSender")
  auditLogs               AuditLog[]                 @relation("AuditActor")
  introsRequested         Introduction[]             @relation("IntroRequester")
  introsAskedOfMe         Introduction[]             @relation("IntroIntroducer")
  introsForMe             Introduction[]             @relation("IntroTarget")
  requestVotes            RequestVote[]
  winsLogged              Win[]                      @relation("WinAuthor")
  winsWith                WinParticipant[]
  winPrompts              WinPrompt[]
  gatheringsHosted        GatheringHost[]
  gatheringInvites        GatheringInvite[]
  seatRequests            SeatRequest[]

  @@index([accountStatus, createdAt])
  @@index([approvedAt])
}

// DB-backed sessions so status/admin changes apply immediately (G3).
model Session {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  userAgent    String?

  @@index([userId])
}

// Single-use hashed tokens for email verification and password reset (G11).
model AuthToken {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  purpose   TokenPurpose
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([userId, purpose])
}

// Failed-login tracking per (email, ip) to throttle without enabling lockout DoS (G7).
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, ip, createdAt])
  @@index([email, createdAt])
}

model Profile {
  id                     String     @id @default(cuid())
  userId                 String     @unique
  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  primaryRole            RoleType
  secondaryRoles         RoleType[]
  headline               String?
  professionalBackground String?    @db.Text
  expertiseAreas         String[] // normalized tags (G13)
  currentFocus           String?    @db.Text
  needs                  String?    @db.Text
  offerings              String?    @db.Text
  city                   String? // free text (was "location"; R3 F6)
  country                String? // ISO 3166-1 alpha-2 code
  openTo                 String[] // see OPEN_TO_OPTIONS (R3 F6)
  photoKey               String? // storage key prefix; sizes are stored as <key>-512.webp / -128.webp
  photoVersion           Int        @default(0)
  linkedInUrl            String?
  websiteUrl             String?

  // Founder
  companyName            String?
  companyStage           String?
  industry               String?
  fundingStatus          String?
  raiseAmount            Int? // USD thousands, when raising
  // Operator
  functionalExpertise    String?
  seniorityLevel         String?
  operationalFocus       String[]
  // Investor
  firmName               String?
  investorType           String?
  leadsRounds            String? // Leads | Follows | Both
  currentlyInvesting     Boolean?
  investingConfirmedAt   DateTime?
  investingCheckSentAt   DateTime? // last "still investing?" email (R3 F9)
  lastCheckMonth         String? // YYYY-MM
  investmentStages       String[]
  checkSizeMin           Int? // USD thousands
  checkSizeMax           Int?
  sectorPreferences      String[]
  // Builder
  technicalSkills        String[]
  projectTypes           String[]
  collaborationInterests String?    @db.Text

  hiddenFields           String[] // subset of HIDEABLE_FIELDS (G5)
  completenessScore      Int        @default(0)
  onboardingCompletedAt  DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@index([primaryRole])
  @@index([completenessScore])
  @@index([country])
}

// No DB-level unique on (sender, receiver): re-requests are allowed after expiry.
// "At most one PENDING per pair" is enforced transactionally (G6).
model ConnectionRequest {
  id          String                  @id @default(cuid())
  senderId    String
  sender      User                    @relation("RequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User                    @relation("RequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  message     String?                 @db.VarChar(500)
  status      ConnectionRequestStatus @default(PENDING)
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime                @default(now())

  @@index([receiverId, status])
  @@index([senderId, status])
  @@index([senderId, createdAt])
  @@index([status, expiresAt])
}

// Canonical pair: userAId < userBId (G6). Soft-removed via removedAt (G9).
model Connection {
  id        String    @id @default(cuid())
  userAId   String
  userA     User      @relation("ConnectionA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User      @relation("ConnectionB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  removedAt DateTime?
  messages  Message[]

  @@unique([userAId, userBId])
  @@index([userBId])
}

model Message {
  id           String     @id @default(cuid())
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User       @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId   String
  receiver     User       @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  content      String     @db.VarChar(5000)
  readAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([connectionId, createdAt])
  @@index([receiverId, readAt])
  @@index([senderId, createdAt])
}

model DismissedRecommendation {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation("Dismisser", fields: [userId], references: [id], onDelete: Cascade)
  dismissedUserId String
  dismissedUser   User     @relation("Dismissed", fields: [dismissedUserId], references: [id], onDelete: Cascade)
  dismissedAt     DateTime @default(now())
  showAgainAfter  DateTime

  @@unique([userId, dismissedUserId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id             String       @id @default(cuid())
  // Reports outlive account deletion so nobody can erase reports by deleting their account (G11).
  reporterId       String?
  reporter         User?        @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reportedUserId   String?
  reportedUser     User?        @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reportedUserName String // snapshot at report time
  messageId      String?
  messageExcerpt String?      @db.VarChar(5000) // snapshot, in case the message is deleted
  reason         ReportReason
  details        String?      @db.VarChar(2000)
  status         ReportStatus @default(OPEN)
  resolvedById   String?
  resolvedBy     User?        @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote String?      @db.Text
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([status, createdAt])
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionRequest  Boolean  @default(true)
  connectionAccepted Boolean  @default(true)
  newMessage         Boolean  @default(true)
  investingCheckins  Boolean  @default(true)
  introductions      Boolean  @default(true)
  gatheringsNearMe   Boolean  @default(true)
  winConfirmations   Boolean  @default(true)
  winPrompts         Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

// Durable outbox: emails are enqueued in the same transaction as the event (G12).
model EmailOutbox {
  id          String      @id @default(cuid())
  to          String
  subject     String
  html        String      @db.Text
  text        String      @db.Text
  kind        String // e.g. 'connection_request', 'password_reset'
  dedupeKey   String?     @unique // used for message-email coalescing
  unsubscribeUrl String?
  status      EmailStatus @default(PENDING)
  attempts    Int         @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError   String?     @db.Text
  sentAt      DateTime?
  createdAt   DateTime    @default(now())

  @@index([status, nextAttemptAt])
}

model PotentialMember {
  id               String         @id @default(cuid())
  email            String?        @unique // optional; normalized (G16)
  linkedInUrl      String?        @unique // canonical form (G16, G18)
  name             String
  company          String?
  role             String?
  discoverySource  String?
  referrerName     String?
  referrerEmail    String?
  lawfulBasisNote  String?        @db.Text
  outreachStatus   OutreachStatus @default(IDENTIFIED)
  nextFollowUpDate DateTime?      @db.Date // date-only (G16)
  assignedAdminId  String?
  assignedAdmin    User?          @relation("PotentialMemberAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  userId           String?        @unique // linked member account (G10)
  user             User?          @relation("PotentialMemberUser", fields: [userId], references: [id], onDelete: SetNull)
  archivedAt       DateTime? // soft archive; never for DO_NOT_CONTACT (G8)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  notes         OutreachNote[]
  attempts      OutreachAttempt[]
  statusChanges PotentialMemberStatusChange[]
  invitations   Invitation[]
  requests      InvitationRequest[]

  @@index([outreachStatus])
  @@index([nextFollowUpDate])
  @@index([archivedAt])
}

model OutreachNote {
  id                String          @id @default(cuid())
  potentialMemberId String
  potentialMember   PotentialMember @relation(fields: [potentialMemberId], references: [id], onDelete: Cascade)
  content           String          @db.Text
  createdById       String?
  createdAt         DateTime        @default(now())

  @@index([potentialMemberId, createdAt])
}

model OutreachAttempt {
  id                String          @id @default(cuid())
  potentialMemberId String
  potentialMember   PotentialMember @relation(fields: [potentialMemberId], references: [id], onDelete: Cascade)
  attemptDate       DateTime        @db.Date
  method            String
  outcome           String?         @db.Text
  createdById       String?
  createdAt         DateTime        @default(now())

  @@index([potentialMemberId, attemptDate])
}

// Every status change, from any path (G16), powering conversion metrics.
model PotentialMemberStatusChange {
  id                String          @id @default(cuid())
  potentialMemberId String
  potentialMember   PotentialMember @relation(fields: [potentialMemberId], references: [id], onDelete: Cascade)
  fromStatus        OutreachStatus?
  toStatus          OutreachStatus
  changedById       String? // null = system
  createdAt         DateTime        @default(now())

  @@index([toStatus, createdAt])
  @@index([potentialMemberId, createdAt])
}

model Invitation {
  id                String           @id @default(cuid())
  email             String
  tokenHash         String           @unique
  potentialMemberId String?
  potentialMember   PotentialMember? @relation(fields: [potentialMemberId], references: [id], onDelete: SetNull)
  invitedById       String?
  invitedBy         User?            @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt         DateTime
  usedAt            DateTime?
  revokedAt         DateTime?
  reminderSentAt    DateTime? // one reminder after 7 days (R3 F4)
  createdAt         DateTime         @default(now())

  @@index([email])
}

enum InviteRequestStatus {
  OPEN
  INVITED
  DECLINED
  SPAM
}

// A public "Request an invitation" submission (R3 F3). Always belongs to a prospect record.
model InvitationRequest {
  id                String              @id @default(cuid())
  potentialMemberId String
  potentialMember   PotentialMember     @relation(fields: [potentialMemberId], references: [id], onDelete: Cascade)
  name              String
  email             String
  linkedInUrl       String?
  primaryRole       RoleType
  city              String?
  country           String
  statement         String              @db.Text
  referrer          String?
  consentAt         DateTime
  status            InviteRequestStatus @default(OPEN)
  slaStartsAt       DateTime            @default(now()) // the 21-day answer clock
  decidedAt         DateTime?
  decidedById       String?
  decisionNote      String?             @db.Text
  /// Submitted while applications were closed; the 21-day clock starts when they reopen (R2).
  waitlisted        Boolean             @default(false)
  createdAt         DateTime            @default(now())
  votes             RequestVote[]

  @@index([status, slaStartsAt])
  @@index([potentialMemberId])
}

// Throttling for public forms without storing raw IP addresses (R3 F3).
model PublicSubmission {
  id        String   @id @default(cuid())
  kind      String
  ipHash    String
  email     String?
  createdAt DateTime @default(now())

  @@index([kind, ipHash, createdAt])
  @@index([kind, email, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------- R3 F12: warm introductions

enum IntroductionStatus {
  ASKED                  // waiting for the introducer (a member, or the team)
  FORWARDED              // introduced; waiting for the target
  ACCEPTED
  DECLINED_BY_INTRODUCER // silent
  DECLINED_BY_TARGET     // silent
  EXPIRED
  CANCELLED
}

/// A asks B (or the Women Builders team) to introduce her to C.
model Introduction {
  id                String             @id @default(cuid())
  requesterId       String
  requester         User               @relation("IntroRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  /// Null for "Ask the team" introductions.
  introducerId      String?
  introducer        User?              @relation("IntroIntroducer", fields: [introducerId], references: [id], onDelete: Cascade)
  viaTeam           Boolean            @default(false)
  targetId          String
  target            User               @relation("IntroTarget", fields: [targetId], references: [id], onDelete: Cascade)
  noteToIntroducer  String             @db.Text
  noteToTarget      String?            @db.Text
  introducerNote    String?            @db.Text
  status            IntroductionStatus @default(ASKED)
  introducerDueAt   DateTime
  targetDueAt       DateTime?
  forwardedAt       DateTime?
  respondedAt       DateTime?
  /// The admin who handled a team introduction.
  handledById       String?
  createdAt         DateTime           @default(now())
  wins              Win[]

  @@index([requesterId, status])
  @@index([introducerId, status])
  @@index([targetId, status])
  @@index([viaTeam, status])
}

// ---------------------------------------------------------------- R3 F14/F23: gatherings

enum GatheringType {
  DINNER
  WORKING_SESSION
  OTHER
}

enum GatheringAudience {
  ALL
  ROLES
  INVITE_ONLY
}

enum SeatMode {
  CURATED // members request, the team confirms
  OPEN    // first come, first served, with a waitlist
}

enum GatheringStatus {
  SCHEDULED
  CANCELLED
}

enum SeatStatus {
  REQUESTED
  CONFIRMED
  WAITLISTED
  DECLINED
  CANCELLED
}

enum Attendance {
  ATTENDED
  NO_SHOW
}

model Gathering {
  id                String            @id @default(cuid())
  title             String
  type              GatheringType
  description       String            @db.Text
  startsAt          DateTime // UTC
  timeZone          String // IANA, e.g. Africa/Lagos
  durationMinutes   Int
  online            Boolean           @default(false)
  city              String?
  country           String? // ISO 3166-1 alpha-2
  /// Venue address or online link: confirmed attendees and hosts only.
  venue             String?           @db.Text
  capacity          Int
  audience          GatheringAudience @default(ALL)
  audienceRoles     RoleType[]
  seatMode          SeatMode          @default(CURATED)
  requestsCloseAt   DateTime
  teamHosted        Boolean           @default(true)
  showOnPublicSite  Boolean           @default(false)
  status            GatheringStatus   @default(SCHEDULED)
  cancelReason      String?           @db.Text
  createdById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  nearbyNotifiedAt  DateTime?
  reminder2dSentAt  DateTime?
  reminderDaySentAt DateTime?
  hosts             GatheringHost[]
  invites           GatheringInvite[]
  seats             SeatRequest[]
  wins              Win[]

  @@index([status, startsAt])
}

model GatheringHost {
  gatheringId String
  gathering   Gathering @relation(fields: [gatheringId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([gatheringId, userId])
}

/// Members invited to an invite-only gathering.
model GatheringInvite {
  gatheringId String
  gathering   Gathering @relation(fields: [gatheringId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([gatheringId, userId])
}

model SeatRequest {
  id          String      @id @default(cuid())
  gatheringId String
  gathering   Gathering   @relation(fields: [gatheringId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  note        String?     @db.Text
  status      SeatStatus  @default(REQUESTED)
  lateCancel  Boolean     @default(false)
  attendance  Attendance?
  createdAt   DateTime    @default(now())
  decidedAt   DateTime?

  @@unique([gatheringId, userId])
  @@index([userId, status])
}

// ---------------------------------------------------------------- R3 F21/F26 (R2): votes and site settings

enum VoteChoice {
  APPROVE
  DECLINE
}

/// One vote per admin or member reviewer per request; editable until the request is decided.
model RequestVote {
  id        String            @id @default(cuid())
  requestId String
  request   InvitationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  voterId   String
  voter     User              @relation(fields: [voterId], references: [id], onDelete: Cascade)
  choice    VoteChoice
  note      String?           @db.Text
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([requestId, voterId])
}

/// Admin-editable site settings (R3 F26). One row per key; values are JSON.
model SiteSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}

// ---------------------------------------------------------------- R3 F15 (R2): wins

enum WinType {
  INVESTMENT
  HIRE
  ADVISOR
  CUSTOMER
  COFOUNDER
  SPEAKING
  OTHER
}

enum WinSource {
  INTRODUCTION
  CONNECTION
  GATHERING
  OTHER
}

enum WinVisibility {
  ANONYMOUS // counted in totals only (default)
  MEMBERS   // members can see it
  QUOTABLE  // may be quoted on the public site
}

enum WinParticipantStatus {
  PENDING
  CONFIRMED
  DECLINED
}

/// Something the network produced: an investment, a hire, an advisor…
model Win {
  id             String           @id @default(cuid())
  authorId       String
  author         User             @relation("WinAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  type           WinType
  source         WinSource        @default(OTHER)
  introductionId String?
  introduction   Introduction?    @relation(fields: [introductionId], references: [id], onDelete: SetNull)
  gatheringId    String?
  gathering      Gathering?       @relation(fields: [gatheringId], references: [id], onDelete: SetNull)
  /// Someone outside the network was involved.
  outsideNetwork Boolean          @default(false)
  month          String // YYYY-MM
  /// USD thousands, investments only. Always private: team totals only.
  amountK        Int?
  story          String?          @db.Text
  visibility     WinVisibility    @default(ANONYMOUS)
  verifiedAt     DateTime?
  createdAt      DateTime         @default(now())
  participants   WinParticipant[]

  @@index([authorId, createdAt])
  @@index([createdAt])
}

/// A member named in a win, asked to confirm it.
model WinParticipant {
  winId       String
  win         Win                  @relation(fields: [winId], references: [id], onDelete: Cascade)
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      WinParticipantStatus @default(PENDING)
  respondedAt DateTime?

  @@id([winId, userId])
  @@index([userId, status])
}

enum WinPromptKind {
  INTRODUCTION
  GATHERING
}

/// "Did anything come of it?" prompts: at most one per member per item.
model WinPrompt {
  id     String        @id @default(cuid())
  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   WinPromptKind
  refId  String
  sentAt DateTime      @default(now())

  @@unique([userId, kind, refId])
}
